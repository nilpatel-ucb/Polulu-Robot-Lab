/**
 * Blink the default LED on the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>.
 * @author Abhi Gundrala
 * @author Edward A. Lee
 */
 
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
  keepalive: true
}
import Display from "lib/Display.lf"
preamble {=
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
//   #include <pololu-3pi-c>
=}

main reactor {
  state previous_bit: uint32_t = 1
  state prev_time: instant_t = 0
 

  timer t(0, 250 ms)
//   state led_on: bool = false
  dis = new Display()

  //First thing is get the state of the button
reaction(startup) {=
    gpio_init(25);
    gpio_set_dir(25, GPIO_IN);
    gpio_pull_up(25);
  =}
  
  
  
  reaction(t) -> dis.line0, dis.line1{=
    volatile uint32_t *in = (volatile uint32_t *) 0xd0000004;
    // printf(*in)
    uint32_t value = *in;
    // printf(value)
    //now bit shift
    // unit32_t gpio_v = PICO_DEFAULT_LED_PIN
    // vol = gpio_get(gpio_v)
    // uint32_t bit; 
    uint32_t bit = (value >> 25) & 1UL;
    static char buf0[17];
    static char buf1[17];
    instant_t currtime = lf_time_physical_elapsed();
    if ((currtime - self->prev_time) > 200000000){
        //Its just pressed 
        if (bit == 0 && self-> previous_bit == 1 ){
        
            snprintf(buf0, 17,  "Button Pressed");
            instant_t passed_time1 = lf_time_logical_elapsed();
            self->prev_time = passed_time1;
            snprintf(buf1, 17,"%lld", (long long)  passed_time1/1000000);
            lf_set(dis.line0, buf0);
            lf_set(dis.line1, buf1);
        

        //JUST RELEEAAASED
        } else if (bit == 1 && self-> previous_bit == 0){
        
            snprintf(buf0, 17, "Button Not Pressed");
            instant_t passed_time2 = lf_time_logical_elapsed();
            self->prev_time = passed_time2;
            snprintf(buf1, 17,"%lld", (long long)  passed_time2/1000000);   

            lf_set(dis.line0, buf0);
            lf_set(dis.line1, buf1);
        }

        self->previous_bit = bit;
    }
  =}

  
}
